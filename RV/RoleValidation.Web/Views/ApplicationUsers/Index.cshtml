@model ApplicationUserListViewModel
@{
    Layout = User.IsInRole("Local_IT_Admin")
        ? "_ApplicationUsersLocalItLayout"
        : "_Layout";
    ViewData["ManagementPage"] = "Application users";
    ViewData["ManagementContext"] = Model.SelectedApplicationName ?? "No application";
    ViewData["Title"] = "Application users";
    string Display(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    int[] pageSizes = [25, 50, 100, 200];
    HashSet<int> selectedMappedRoleIds = Model.SelectedMappedRoleIds.ToHashSet();
    int selectedMappedRoleCount =
        Model.MappedRoleSelectionMode == MappedRoleSelectionMode.All
            ? Model.AvailableMappedRoles.Count
            : Model.SelectedMappedRoleIds.Count;
    string mappedRoleSummary = Model.MappedRoleSelectionMode switch
    {
        MappedRoleSelectionMode.All => "All mapped roles",
        MappedRoleSelectionMode.None => "No mapped roles",
        _ => $"{selectedMappedRoleCount} mapped roles"
    };
    List<KeyValuePair<string, string>> employeeStatusOptions =
        Enum.GetValues<EmployeeStatusType>()
            .Select(status => new KeyValuePair<string, string>(
                status.ToString(),
                status.ToString()))
            .ToList();
    List<KeyValuePair<string, string>> auditedOptions =
    [
        new("true", "True"),
        new("false", "False")
    ];
    List<KeyValuePair<string, string>> resolutionOptions =
        Enum.GetValues<SourceRoleResolutionType>()
            .Select(status => new KeyValuePair<string, string>(
                status.ToString(),
                status.ToString()))
            .ToList();
    var statusFilters = new[]
    {
        new
        {
            Label = "Employee status",
            ValueName = "employeeStatus",
            ModeName = "employeeStatusSelectionMode",
            Mode = Model.EmployeeStatusSelectionMode,
            SelectedValues = Model.SelectedEmployeeStatuses
                .Select(status => status.ToString())
                .ToHashSet(StringComparer.OrdinalIgnoreCase),
            Options = employeeStatusOptions,
            AllSummary = "All statuses",
            NoneSummary = "No statuses",
            SelectedSuffix = "statuses",
            SearchPlaceholder = "Search employee status",
            LabelId = "employee-status-label",
            OptionsId = "employee-status-options"
        },
        new
        {
            Label = "Is audited",
            ValueName = "isAudited",
            ModeName = "auditedSelectionMode",
            Mode = Model.AuditedSelectionMode,
            SelectedValues = Model.SelectedAuditedStatuses
                .Select(value => value.ToString().ToLowerInvariant())
                .ToHashSet(StringComparer.OrdinalIgnoreCase),
            Options = auditedOptions,
            AllSummary = "All audit states",
            NoneSummary = "No audit states",
            SelectedSuffix = "audit states",
            SearchPlaceholder = "Search audit state",
            LabelId = "audited-status-label",
            OptionsId = "audited-status-options"
        },
        new
        {
            Label = "Mapping status",
            ValueName = "resolutionType",
            ModeName = "resolutionSelectionMode",
            Mode = Model.ResolutionSelectionMode,
            SelectedValues = Model.SelectedResolutionTypes
                .Select(status => status.ToString())
                .ToHashSet(StringComparer.OrdinalIgnoreCase),
            Options = resolutionOptions,
            AllSummary = "All mappings",
            NoneSummary = "No mappings",
            SelectedSuffix = "mappings",
            SearchPlaceholder = "Search mapping status",
            LabelId = "mapping-status-label",
            OptionsId = "mapping-status-options"
        }
    };
    string FilterSummary(
        FilterSelectionMode mode,
        int selectedCount,
        string allSummary,
        string noneSummary,
        string selectedSuffix) => mode switch
        {
            FilterSelectionMode.All => allSummary,
            FilterSelectionMode.None => noneSummary,
            _ => $"{selectedCount} {selectedSuffix}"
        };
    int visiblePageCount = Math.Min(5, Model.TotalPages);
    int firstVisiblePage = Math.Max(1, Model.PageNumber - 2);
    int lastVisiblePage = Math.Min(
        Model.TotalPages,
        firstVisiblePage + visiblePageCount - 1);
    firstVisiblePage = Math.Max(
        1,
        lastVisiblePage - visiblePageCount + 1);
}

<section class="page-shell" data-review-page>
    <header class="page-heading">
        <div>
            <p class="eyebrow">Access review ledger</p>
            <h1>Application users</h1>
            <p>Review employee status, role mappings, and data scope before exporting.</p>
        </div>
        <div class="scope-stamp" aria-label="Current data scope">
            <span>Current scope</span>
            <strong>@(Model.SelectedApplicationName ?? "No application")</strong>
            <small>@Model.TotalCount matching rows</small>
            @if (Model.SelectedApplicationId.HasValue)
            {
                <a asp-controller="Applications"
                   asp-action="Index"
                   asp-fragment="application-@Model.SelectedApplicationId">
                    View application configuration
                </a>
            }
        </div>
    </header>

    <form method="get" class="filter-panel" data-load-form>
        <div class="filter-grid">
            <label>
                <span>Application</span>
                <select id="applicationId"
                        name="applicationId"
                        required
                        data-application-select>
                    @foreach (ApplicationOptionViewModel application in Model.Applications)
                    {
                        <option value="@application.ApplicationId"
                                selected="@(application.ApplicationId == Model.SelectedApplicationId)">
                            @application.ApplicationName
                        </option>
                    }
                </select>
            </label>

            <label class="search-field">
                <span>Search</span>
                <input type="search"
                       name="search"
                       value="@Model.Search"
                       placeholder="Employee, username, name or role" />
            </label>

            <div class="role-filter"
                 data-mapped-role-filter
                 data-multi-select-filter
                 data-all-summary="All mapped roles"
                 data-none-summary="No mapped roles"
                 data-selected-suffix="mapped roles"
                 data-unavailable-summary="No mapped roles available">
                <span id="mapped-role-label" class="filter-label">
                    Mapped roles
                </span>
                <input type="hidden"
                       name="mappedRoleSelectionMode"
                       value="@Model.MappedRoleSelectionMode"
                       data-filter-mode />
                <button type="button"
                        class="role-filter-toggle"
                        aria-expanded="false"
                        aria-controls="mapped-role-options"
                        data-filter-toggle>
                    <span data-filter-summary>@mappedRoleSummary</span>
                    <span class="role-filter-count" data-filter-counter>
                        @selectedMappedRoleCount selected
                    </span>
                    <span class="role-filter-chevron" aria-hidden="true">⌄</span>
                </button>
                <div class="role-filter-panel" data-filter-panel hidden>
                    <div class="role-filter-search-row">
                        <input type="search"
                               placeholder="Search mapped roles"
                               aria-label="Search mapped roles"
                               data-filter-search />
                        <button type="button"
                                class="role-filter-clear"
                                data-filter-clear>
                            Clear
                        </button>
                    </div>
                    <div id="mapped-role-options"
                         class="role-filter-options"
                         role="group"
                         aria-labelledby="mapped-role-label">
                        <label class="role-filter-option role-filter-select-all"
                               data-filter-select-all-label>
                            <input type="checkbox"
                                   checked="@(Model.MappedRoleSelectionMode == MappedRoleSelectionMode.All)"
                                   data-filter-select-all />
                            <span class="role-filter-check" aria-hidden="true">✓</span>
                            <span>Select all</span>
                        </label>
                        @foreach (ApplicationUserMappedRoleOption role in Model.AvailableMappedRoles)
                        {
                            bool selected =
                                Model.MappedRoleSelectionMode == MappedRoleSelectionMode.All ||
                                selectedMappedRoleIds.Contains(role.RoleId);
                            <label class="role-filter-option"
                                   data-filter-option-label
                                   data-selected="@selected.ToString().ToLowerInvariant()">
                                <input type="checkbox"
                                       name="mappedRoleIds"
                                       value="@role.RoleId"
                                       checked="@selected"
                                       data-filter-option />
                                <span class="role-filter-check" aria-hidden="true">✓</span>
                                <span>@role.RoleName</span>
                            </label>
                        }
                    </div>
                </div>
                <small>Select all is the default</small>
            </div>

            @foreach (var filter in statusFilters)
            {
                int selectedCount = filter.Mode == FilterSelectionMode.All
                    ? filter.Options.Count
                    : filter.SelectedValues.Count;
                string summary = FilterSummary(
                    filter.Mode,
                    selectedCount,
                    filter.AllSummary,
                    filter.NoneSummary,
                    filter.SelectedSuffix);

                <div class="role-filter"
                     data-multi-select-filter
                     data-all-summary="@filter.AllSummary"
                     data-none-summary="@filter.NoneSummary"
                     data-selected-suffix="@filter.SelectedSuffix"
                     data-unavailable-summary="@filter.NoneSummary">
                    <span id="@filter.LabelId" class="filter-label">
                        @filter.Label
                    </span>
                    <input type="hidden"
                           name="@filter.ModeName"
                           value="@filter.Mode"
                           data-filter-mode />
                    <button type="button"
                            class="role-filter-toggle"
                            aria-expanded="false"
                            aria-controls="@filter.OptionsId"
                            data-filter-toggle>
                        <span data-filter-summary>@summary</span>
                        <span class="role-filter-count" data-filter-counter>
                            @selectedCount selected
                        </span>
                        <span class="role-filter-chevron" aria-hidden="true">⌄</span>
                    </button>
                    <div class="role-filter-panel" data-filter-panel hidden>
                        <div class="role-filter-search-row">
                            <input type="search"
                                   placeholder="@filter.SearchPlaceholder"
                                   aria-label="@filter.SearchPlaceholder"
                                   data-filter-search />
                            <button type="button"
                                    class="role-filter-clear"
                                    data-filter-clear>
                                Clear
                            </button>
                        </div>
                        <div id="@filter.OptionsId"
                             class="role-filter-options"
                             role="group"
                             aria-labelledby="@filter.LabelId">
                            <label class="role-filter-option role-filter-select-all"
                                   data-filter-select-all-label>
                                <input type="checkbox"
                                       checked="@(filter.Mode == FilterSelectionMode.All)"
                                       data-filter-select-all />
                                <span class="role-filter-check" aria-hidden="true">✓</span>
                                <span>Select all</span>
                            </label>
                            @foreach (KeyValuePair<string, string> option in filter.Options)
                            {
                                bool selected =
                                    filter.Mode == FilterSelectionMode.All ||
                                    filter.SelectedValues.Contains(option.Key);
                                <label class="role-filter-option"
                                       data-filter-option-label
                                       data-selected="@selected.ToString().ToLowerInvariant()">
                                    <input type="checkbox"
                                           name="@filter.ValueName"
                                           value="@option.Key"
                                           checked="@selected"
                                           data-filter-option />
                                    <span class="role-filter-check" aria-hidden="true">✓</span>
                                    <span>@option.Value</span>
                                </label>
                            }
                        </div>
                    </div>
                    <small>Select all is the default</small>
                </div>
            }

            <label>
                <span>Rows per page</span>
                <select name="pageSize">
                    @foreach (int size in pageSizes)
                    {
                        <option value="@size" selected="@(Model.PageSize == size)">
                            @size
                        </option>
                    }
                </select>
            </label>
        </div>

        <input type="hidden" name="sortBy" value="@Model.SortBy" />
        <input type="hidden"
               name="sortDirection"
               value="@Model.SortDirection" />
        <input type="hidden" name="page" value="1" />
        <div class="filter-actions">
            <button type="submit">Apply filters</button>
            <a asp-action="Index"
               asp-route-applicationId="@Model.SelectedApplicationId"
               class="button-secondary">Clear filters</a>
        </div>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert" role="alert">@Model.ErrorMessage</div>
    }

    <div class="review-ledger" aria-label="Review summary">
        <div><span>Matching rows</span><strong>@Model.TotalCount</strong></div>
        <div><span>Resolved</span><strong>@Model.ResolvedCount</strong></div>
        <div><span>Needs mapping</span><strong>@Model.NeedsMappingCount</strong></div>
        <div><span>Inactive</span><strong>@Model.InactiveCount</strong></div>
    </div>

    <div class="result-bar">
        <p>
            Showing <strong>@Model.PageStart-@Model.PageEnd</strong>
            of <strong>@Model.TotalCount</strong>
        </p>
        @if (Model.SelectedApplicationId.HasValue)
        {
            <form asp-action="Export" method="get" data-export-form>
                <input type="hidden" name="applicationId" value="@Model.SelectedApplicationId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden"
                       name="sortDirection"
                       value="@Model.SortDirection" />
                <input type="hidden"
                       name="employeeStatusSelectionMode"
                       value="@Model.EmployeeStatusSelectionMode" />
                @foreach (EmployeeStatusType status in Model.SelectedEmployeeStatuses)
                {
                    <input type="hidden" name="employeeStatus" value="@status" />
                }
                <input type="hidden"
                       name="auditedSelectionMode"
                       value="@Model.AuditedSelectionMode" />
                @foreach (bool audited in Model.SelectedAuditedStatuses)
                {
                    <input type="hidden"
                           name="isAudited"
                           value="@audited.ToString().ToLowerInvariant()" />
                }
                <input type="hidden"
                       name="resolutionSelectionMode"
                       value="@Model.ResolutionSelectionMode" />
                @foreach (SourceRoleResolutionType status in Model.SelectedResolutionTypes)
                {
                    <input type="hidden" name="resolutionType" value="@status" />
                }
                <input type="hidden"
                       name="mappedRoleSelectionMode"
                       value="@Model.MappedRoleSelectionMode" />
                @foreach (int roleId in Model.SelectedMappedRoleIds)
                {
                    <input type="hidden" name="mappedRoleIds" value="@roleId" />
                }
                <button type="submit" class="button-export" disabled="@(Model.TotalCount == 0)">
                    Export filtered .xlsx
                </button>
            </form>
        }
    </div>

    <div class="table-card">
        <div class="table-scroll">
            <table data-user-table>
                <thead>
                    <tr>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.EmployeeNumber)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.EmployeeNumber"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.EmployeeNumber)">
                                Employee number
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.UserName)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.UserName"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.UserName)">
                                Username
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.FullName)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.FullName"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.FullName)">
                                Full name
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.Position)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.Position"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.Position)">
                                Position
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.Department)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.Department"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.Department)">
                                Department
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.SourceRole)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.SourceRole"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.SourceRole)">
                                Source role
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.MappedRole)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.MappedRole"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.MappedRole)">
                                Mapped role
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.IsAudited)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.IsAudited"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.IsAudited)">
                                Is audited
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.DaysSinceLastLogin)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.DaysSinceLastLogin"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.DaysSinceLastLogin)">
                                Days since login
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.EmployeeStatus)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.EmployeeStatus"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.EmployeeStatus)">
                                Employee status
                            </button>
                        </th>
                        <th scope="col"
                            aria-sort="@Model.GetAriaSortValue(ApplicationUserSortField.MappingStatus)">
                            <button type="button"
                                    class="table-sort-button"
                                    data-sortable
                                    data-sort-key="@ApplicationUserSortField.MappingStatus"
                                    data-next-sort-direction="@Model.GetNextSortDirection(ApplicationUserSortField.MappingStatus)">
                                Mapping status
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (ApplicationUserRowViewModel user in Model.Users)
                    {
                        string employeeStatus = user.EmployeeStatusType
                            .ToString()
                            .ToLowerInvariant();
                        string mappingStatus =
                            user.ResolutionType == SourceRoleResolutionType.Resolved
                                ? "resolved"
                                : "needs-mapping";
                        string auditedStatus = user.IsAudited switch
                        {
                            true => "audited",
                            false => "not-audited",
                            _ => "unknown"
                        };
                        string auditedLabel = user.IsAudited switch
                        {
                            true => "True",
                            false => "False",
                            _ => "-"
                        };

                        <tr>
                            <td class="mono">@Display(user.EmployeeNo)</td>
                            <td>@Display(user.UserName)</td>
                            <td>
                                <strong>@Display(user.EmployeeName)</strong>
                                <small>@Display(user.Email)</small>
                            </td>
                            <td>@Display(user.Position)</td>
                            <td>@Display(user.Department)</td>
                            <td>
                                <span class="mono">@user.SourceRoleKey</span>
                                <small>@Display(user.SourceRoleDisplayName)</small>
                            </td>
                            <td>@Display(user.RoleName)</td>
                            <td>
                                <span class="status status-@auditedStatus">
                                    @auditedLabel
                                </span>
                            </td>
                            <td>
                                @(user.DaysSinceLastLogin?.ToString() ?? "-")
                            </td>
                            <td>
                                <span class="status status-@employeeStatus">
                                    @user.EmployeeStatusType
                                </span>
                            </td>
                            <td>
                                <span class="status status-@mappingStatus">
                                    @user.ResolutionType
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.HasSelection &&
             Model.TotalCount == 0 &&
             string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="empty-state">
                <strong>No users match this scope</strong>
                <span>Change the search, mapped-role filter, or status and try again.</span>
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <form method="get" class="pager" data-load-form>
                <input type="hidden" name="applicationId" value="@Model.SelectedApplicationId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden"
                       name="sortDirection"
                       value="@Model.SortDirection" />
                <input type="hidden"
                       name="employeeStatusSelectionMode"
                       value="@Model.EmployeeStatusSelectionMode" />
                @foreach (EmployeeStatusType status in Model.SelectedEmployeeStatuses)
                {
                    <input type="hidden" name="employeeStatus" value="@status" />
                }
                <input type="hidden"
                       name="auditedSelectionMode"
                       value="@Model.AuditedSelectionMode" />
                @foreach (bool audited in Model.SelectedAuditedStatuses)
                {
                    <input type="hidden"
                           name="isAudited"
                           value="@audited.ToString().ToLowerInvariant()" />
                }
                <input type="hidden"
                       name="resolutionSelectionMode"
                       value="@Model.ResolutionSelectionMode" />
                @foreach (SourceRoleResolutionType status in Model.SelectedResolutionTypes)
                {
                    <input type="hidden" name="resolutionType" value="@status" />
                }
                <input type="hidden"
                       name="mappedRoleSelectionMode"
                       value="@Model.MappedRoleSelectionMode" />
                @foreach (int roleId in Model.SelectedMappedRoleIds)
                {
                    <input type="hidden" name="mappedRoleIds" value="@roleId" />
                }

                @if (Model.PageNumber > 1)
                {
                    <button type="submit"
                            name="page"
                            value="1"
                            class="button-secondary">First</button>
                    <button type="submit"
                            name="page"
                            value="@(Model.PageNumber - 1)"
                            class="button-secondary">Previous</button>
                }
                else
                {
                    <span class="button-secondary" aria-disabled="true">First</span>
                    <span class="button-secondary" aria-disabled="true">Previous</span>
                }

                @for (int pageNumber = firstVisiblePage;
                      pageNumber <= lastVisiblePage;
                      pageNumber++)
                {
                    if (pageNumber == Model.PageNumber)
                    {
                        <span class="button-secondary pager-page"
                              aria-current="page">@pageNumber</span>
                    }
                    else
                    {
                        <button type="submit"
                                name="page"
                                value="@pageNumber"
                                class="button-secondary pager-page"
                                aria-label="Page @pageNumber">@pageNumber</button>
                    }
                }

                @if (Model.PageNumber < Model.TotalPages)
                {
                    <button type="submit"
                            name="page"
                            value="@(Model.PageNumber + 1)"
                            class="button-secondary">Next</button>
                    <button type="submit"
                            name="page"
                            value="@Model.TotalPages"
                            class="button-secondary">Last</button>
                }
                else
                {
                    <span class="button-secondary" aria-disabled="true">Next</span>
                    <span class="button-secondary" aria-disabled="true">Last</span>
                }
            </form>
        }
    </div>

    <div class="loading-mask" data-loading-mask hidden>
        Loading application users…
    </div>
</section>
